# Copy to .env and fill only the providers you use.
# A missing key disables only that provider; the system still runs.

# Google Gemini / AI Studio (free tier only)
GEMINI_API_KEY=

# Groq (free plan; used for text and Whisper speech-to-text)
GROQ_API_KEY=

# OpenRouter (free model IDs only, e.g. model IDs ending in ":free")
OPENROUTER_API_KEY=

# Optional: override config/data locations (defaults shown)
# CLIPPING_AI_CONFIG_DIR=config
# CLIPPING_AI_DATA_DIR=data

# Optional: local API bind (keep loopback for a local-only service)
# CLIPPING_AI_HOST=127.0.0.1
# CLIPPING_AI_PORT=8765

# Optional: request behaviour
# CLIPPING_AI_TIMEOUT_SECONDS=120
# CLIPPING_AI_MAX_RETRIES=2
# CLIPPING_AI_REQUIRE_VERIFIED_FREE=false

# Optional: whisper.cpp local provider (no model downloads are performed)
# CLIPPING_AI_WHISPER_CPP_BINARY=whisper-cli
# CLIPPING_AI_WHISPER_CPP_MODEL_PATH=/path/to/ggml-model.bin
